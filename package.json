{
  "name": "settle-kit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=demo...",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "check-types": "turbo run check-types",
    "check-tokens": "bun scripts/check/tokens.mjs",
    "check-journeys": "bun scripts/journey.ts check docs/journeys",
    "journeys:validate": "bun scripts/journey.ts validate docs/journeys",
    "journeys:render": "bun scripts/journey.ts render docs/journeys",
    "check-skills": "bun scripts/check-skills.ts",
    "test": "bun test",
    "ui:add": "turbo run add --filter=@repo/ui",
    "preinstall": "[ -n \"$CI$VERCEL\" ] || bunx only-allow@1.2.2 bun",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@happy-dom/global-registrator": "^20.11.2",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "turbo": "^2.10.9",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}
